# Membership-only retrieval must preserve scored queries and plan reuse.
--result_format 4
--disable_query_log
--disable_warnings
drop table if exists fts_membership, fts_membership_scores;
--enable_warnings
create table fts_membership(id int primary key, body varchar(200), fulltext index ft(body) with parser beng);
insert into fts_membership values(1,'alpha beta'),(2,'alpha alpha'),(3,'beta'),(4,''),(5,null),(6,'gamma'),(7,'alpha beta gamma'),(8,'the and');
create table fts_membership_scores as select id,match(body) against('alpha beta') as score from fts_membership where match(body) against('alpha beta');
--echo natural language membership and deduplication
select group_concat(id order by id) = '1,2,3,7' as ok from fts_membership where match(body) against('alpha beta alpha');
--echo membership with another predicate
select group_concat(id order by id) = '3,7' as ok from fts_membership where match(body) against('alpha beta') and id > 2;
--echo membership with limit and offset
select count(*) = 2 as ok from (select id from fts_membership where match(body) against('alpha beta') limit 1,2) t;
--echo score projection remains unchanged
select count(*) = 4 and min(abs(t.score - s.score) < 1e-12) as ok from (select id,match(body) against('alpha beta') as score from fts_membership where match(body) against('alpha beta')) t join fts_membership_scores s on t.id=s.id;
--echo ranking uses real relevance
select id = 1 as ok from fts_membership where match(body) against('alpha beta') order by match(body) against('alpha beta') desc limit 1;
--echo boolean mode still scores and excludes
select group_concat(id order by id) = '1,2' as ok from fts_membership where match(body) against('+alpha -gamma' in boolean mode);
--echo boolean score projection still has a MATCH value
select count(*) = 4 and min(hit) = 1 as ok from (select id,match(body) against('alpha beta') > 0 as hit from fts_membership where match(body) against('alpha beta')) t;
--echo score threshold remains a scored filter
select count(*) = (select count(*) from fts_membership_scores where score > 0.8) as ok from fts_membership where match(body) against('alpha beta') > 0.8;
--echo negative score threshold includes nonmatches
select count(*) = 8 as ok from fts_membership where match(body) against('alpha beta') > -0.5;
--echo empty query
select count(*) = 0 as ok from fts_membership where match(body) against('');
--echo stopword query
select count(*) = 0 as ok from fts_membership where match(body) against('the');
--echo absent token
select count(*) = 0 as ok from fts_membership where match(body) against('nonexistent');
--echo taat membership deduplicates overlapping tokens
select group_concat(id order by id) = '1,2,3,7' as ok from fts_membership where match(body) against('term0 term1 term2 term3 term4 term5 term6 term7 term8 term9 term10 term11 term12 term13 term14 term15 term16 term17 term18 term19 term20 term21 term22 term23 term24 term25 term26 term27 term28 term29 term30 term31 term32 term33 term34 term35 term36 term37 term38 term39 term40 term41 term42 term43 term44 term45 term46 term47 term48 term49 term50 term51 term52 term53 term54 term55 term56 term57 term58 term59 term60 term61 term62 term63 term64 term65 term66 term67 term68 term69 term70 term71 term72 term73 term74 term75 term76 term77 term78 term79 term80 term81 term82 term83 term84 term85 term86 term87 term88 term89 term90 term91 term92 term93 term94 term95 term96 term97 term98 term99 term100 term101 term102 term103 term104 term105 term106 term107 term108 term109 term110 term111 term112 term113 term114 term115 term116 term117 term118 term119 term120 term121 term122 term123 term124 term125 term126 term127 term128 term129 term130 term131 term132 term133 term134 term135 term136 term137 term138 term139 term140 term141 term142 term143 term144 term145 term146 term147 term148 term149 term150 term151 term152 term153 term154 term155 term156 term157 term158 term159 term160 term161 term162 term163 term164 term165 term166 term167 term168 term169 term170 term171 term172 term173 term174 term175 term176 term177 term178 term179 term180 term181 term182 term183 term184 term185 term186 term187 term188 term189 term190 term191 term192 term193 term194 term195 term196 term197 term198 term199 term200 term201 term202 term203 term204 term205 term206 term207 term208 term209 term210 term211 term212 term213 term214 term215 term216 term217 term218 term219 term220 term221 term222 term223 term224 term225 term226 term227 term228 term229 term230 term231 term232 term233 term234 term235 term236 term237 term238 term239 term240 term241 term242 term243 term244 term245 term246 term247 term248 term249 term250 term251 term252 term253 term254 term255 term256 term257 term258 term259 alpha beta');
--echo parameterized threshold retains its score across executions
prepare fts_membership_stmt from 'select count(*) = (select count(*) from fts_membership_scores where score > ?) as ok from fts_membership where match(body) against("alpha beta") and match(body) against("alpha beta") > ?';
set @fts_threshold=0;
execute fts_membership_stmt using @fts_threshold,@fts_threshold;
set @fts_threshold=0.8;
execute fts_membership_stmt using @fts_threshold,@fts_threshold;
set @fts_threshold=0;
execute fts_membership_stmt using @fts_threshold,@fts_threshold;
set @fts_threshold=-0.5;
execute fts_membership_stmt using @fts_threshold,@fts_threshold;
deallocate prepare fts_membership_stmt;
--echo membership reflects update within transaction
begin;
update fts_membership set body='gamma' where id=1;
select group_concat(id order by id) = '2,3,7' as ok from fts_membership where match(body) against('alpha beta');
rollback;
--echo membership reflects rollback
select group_concat(id order by id) = '1,2,3,7' as ok from fts_membership where match(body) against('alpha beta');
--echo document ID mapping with string primary keys
create table fts_membership_strings(id varchar(12) primary key, body varchar(100), fulltext index ft(body) with parser beng);
insert into fts_membership_strings values('a','alpha'),('b','beta'),('c','gamma');
select group_concat(id order by id) = 'a,b' as ok from fts_membership_strings where match(body) against('alpha beta');
drop table fts_membership_strings;
drop table fts_membership,fts_membership_scores;
--enable_query_log
