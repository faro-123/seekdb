--echo prepared long and short queries preserve scores
prepare fts_taat_stmt from 'select abs(sum(match(body) against(?)) - (select sum(score) from fts_taat_expected)) < 1e-9 as ok from fts_taat_hash where match(body) against(?)';
execute fts_taat_stmt using @fts_long_query,@fts_long_query;
set @fts_short_query='alpha beta';
execute fts_taat_stmt using @fts_short_query,@fts_short_query;
execute fts_taat_stmt using @fts_long_query,@fts_long_query;
deallocate prepare fts_taat_stmt;
