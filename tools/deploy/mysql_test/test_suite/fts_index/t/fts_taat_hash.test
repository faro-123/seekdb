# Cover storage TAAT hash aggregation, stable string IDs and iterator reuse.
--result_format 4
--disable_query_log
--disable_warnings
drop table if exists fts_taat_hash, fts_taat_expected;
--enable_warnings
create table fts_taat_hash(id varchar(20) primary key, body varchar(100), fulltext index ft(body) with parser beng);
insert into fts_taat_hash values('0','alpha beta beta');
insert into fts_taat_hash select cast(cast(id as unsigned) + 1 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 2 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 4 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 8 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 16 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 32 as char),body from fts_taat_hash;
insert into fts_taat_hash select cast(cast(id as unsigned) + 64 as char),body from fts_taat_hash;
insert into fts_taat_hash values('winner','alpha alpha alpha beta'),('empty',''),('null',null),('gamma','gamma');
create table fts_taat_expected as select id,match(body) against('alpha beta') as score from fts_taat_hash where match(body) against('alpha beta');
set @fts_long_query='term0000 term0001 term0002 term0003 term0004 term0005 term0006 term0007 term0008 term0009 term0010 term0011 term0012 term0013 term0014 term0015 term0016 term0017 term0018 term0019 term0020 term0021 term0022 term0023 term0024 term0025 term0026 term0027 term0028 term0029 term0030 term0031 term0032 term0033 term0034 term0035 term0036 term0037 term0038 term0039 term0040 term0041 term0042 term0043 term0044 term0045 term0046 term0047 term0048 term0049 term0050 term0051 term0052 term0053 term0054 term0055 term0056 term0057 term0058 term0059 term0060 term0061 term0062 term0063 term0064 term0065 term0066 term0067 term0068 term0069 term0070 term0071 term0072 term0073 term0074 term0075 term0076 term0077 term0078 term0079 term0080 term0081 term0082 term0083 term0084 term0085 term0086 term0087 term0088 term0089 term0090 term0091 term0092 term0093 term0094 term0095 term0096 term0097 term0098 term0099 term0100 term0101 term0102 term0103 term0104 term0105 term0106 term0107 term0108 term0109 term0110 term0111 term0112 term0113 term0114 term0115 term0116 term0117 term0118 term0119 term0120 term0121 term0122 term0123 term0124 term0125 term0126 term0127 term0128 term0129 term0130 term0131 term0132 term0133 term0134 term0135 term0136 term0137 term0138 term0139 term0140 term0141 term0142 term0143 term0144 term0145 term0146 term0147 term0148 term0149 term0150 term0151 term0152 term0153 term0154 term0155 term0156 term0157 term0158 term0159 term0160 term0161 term0162 term0163 term0164 term0165 term0166 term0167 term0168 term0169 term0170 term0171 term0172 term0173 term0174 term0175 term0176 term0177 term0178 term0179 term0180 term0181 term0182 term0183 term0184 term0185 term0186 term0187 term0188 term0189 term0190 term0191 term0192 term0193 term0194 term0195 term0196 term0197 term0198 term0199 term0200 term0201 term0202 term0203 term0204 term0205 term0206 term0207 term0208 term0209 term0210 term0211 term0212 term0213 term0214 term0215 term0216 term0217 term0218 term0219